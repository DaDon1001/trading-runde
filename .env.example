# Kopiere diese Datei zu .env und trage deinen Schlüssel ein. .env NIEMALS teilen oder committen.
XAI_API_KEY=<DEIN-KEY>
# Optional: Modell ändern
XAI_MODEL=grok-4.7
# Optional: Name, unter dem du im Chat auftauchst
TRADER_NAME=Daniel
# Optional: MOCK=1 testet die Oberfläche ohne API-Key und ohne Netz
# (Agenten antworten mit Platzhaltern, der Chart zeigt Beispieldaten)
MOCK=0
# Kurse brauchen keinen Key. Live-Daten kommen von Yahoo Finance.
